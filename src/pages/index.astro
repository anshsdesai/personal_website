---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVisual from '../components/HeroVisual.astro';
import { ArrowRight } from 'lucide-astro';
---

<BaseLayout title="Ansh Desai">
  <section class="mx-auto w-full max-w-6xl px-6 pt-16 pb-16 md:pt-24">
    <div class="grid items-center gap-12 md:grid-cols-[0.82fr_1.18fr] md:gap-16">

      <!-- Left: editorial intro (centered on mobile, flush-left from md up) -->
      <div class="animate-fade-in-up text-center md:text-left">
        <p class="mb-6 font-plex-mono text-[11px] uppercase tracking-[0.28em] text-azure">
          PhD Candidate &middot; University of Oregon
        </p>

        <h1 class="mb-6 font-charter font-bold text-deep text-[clamp(3rem,7vw,5rem)] leading-[0.92] tracking-[-0.02em]">
          Ansh Desai
        </h1>

        <p class="mb-9 max-w-[32ch] mx-auto md:mx-0 font-charter text-[clamp(1.15rem,1.7vw,1.4rem)] leading-[1.6] text-ink">
          85% of the mass in our universe made up of a completely invisible form of matter called <span class="text-orange">dark matter</span>. I work on trying to figure out what exactly it is using low-threshold detectors. 
        </p>

        <div class="flex flex-wrap gap-3.5 justify-center md:justify-start">
          <a
            href="/research"
            class="inline-flex items-center gap-2 rounded-lg bg-deep px-7 py-3 font-medium text-paper transition-colors hover:bg-azure-press"
          >
            Research <ArrowRight size="16" />
          </a>
          <a
            href="/about"
            class="rounded-lg border border-line px-7 py-3 font-medium text-deep transition-colors hover:border-azure"
          >
            About
          </a>
        </div>
      </div>

      <!-- Right: interactive "lines of evidence" visual -->
      <HeroVisual />

    </div>
  </section>
</BaseLayout>
