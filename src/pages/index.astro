---
import BaseLayout from '../layouts/BaseLayout.astro';
import DetectorBackground from '../components/DetectorBackground.astro';
import { ChevronRight } from 'lucide-astro';
---

<BaseLayout title="Ansh Desai">
  <DetectorBackground />

  <div
    class="fixed inset-0 z-[2] pointer-events-none"
    style="background: linear-gradient(to right, rgba(9,14,26,0.72) 0%, rgba(9,14,26,0.20) 44%, rgba(9,14,26,0.02) 68%), radial-gradient(ellipse 105% 86% at 72% 48%, transparent 35%, rgba(9,14,26,0.72) 100%);"
    aria-hidden="true"
  ></div>

  <section class="relative z-20 flex min-h-screen items-center px-6 md:px-0 md:pl-[clamp(3rem,7vw,7rem)]">
    <div class="mx-auto flex max-w-xl flex-col items-center text-center md:mx-0 md:max-w-[50%] md:items-start md:text-left animate-fade-in">
      <p class="mb-5 font-jetbrain text-[10px] uppercase tracking-[0.35em] text-slate-500 md:mb-6">
        Ph.D Candidate &middot; University of Oregon
      </p>

      <h1 class="mb-5 text-[clamp(2.5rem,5vw,3.5rem)] font-bold tracking-[0.15em] text-white md:mb-6">
        ANSH DESAI
      </h1>

      <div class="mb-7 h-px w-10 bg-white/15"></div>

      <h2 class="mb-7 text-[clamp(2.45rem,6vw,4.5rem)] font-bold leading-[1.05] tracking-[-0.02em] text-white md:mb-8">
        Detecting the
        <span class="bg-gradient-to-r from-white via-slate-400 to-transparent bg-clip-text text-transparent">Invisible</span>
      </h2>

      <p class="mb-7 max-w-[390px] text-[clamp(0.95rem,1.5vw,1.125rem)] leading-[1.7] text-slate-400 md:mb-8">
        I hunt for light dark matter using next-generation low-threshold detectors.
      </p>

      <div class="mb-9 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 font-jetbrain text-[11px] uppercase tracking-[0.2em] text-slate-400 md:mb-10">
        <span class="h-2 w-2 rounded-full bg-[--color-pulse-green] animate-pulse"></span>
        <span>On the Job Market</span>
      </div>

      <div class="flex flex-wrap justify-center gap-4 md:justify-start">
        <a
          href="/research"
          class="inline-flex items-center justify-center rounded-lg bg-white px-8 py-3 font-medium leading-none text-slate-900 shadow-[0_0_20px_rgba(255,255,255,0.1)] transition-all hover:bg-slate-200 hover:shadow-[0_0_30px_rgba(255,255,255,0.2)]"
        >
          View Research <ChevronRight size="16" class="ml-2" />
        </a>

        <a
          href="/about"
          class="rounded-lg border border-slate-700 bg-transparent px-8 py-3 font-medium text-slate-300 transition-all hover:border-white/50 hover:bg-white/5"
        >
          About Me
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
