---
// import mod from 'astro/zod';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { Clock, Github, Linkedin, Mail } from 'lucide-astro';
import InspireHepSVG from '../icons/inspireHEP.svg';
import gscholarSVG from '../icons/Google_Scholar_logo.svg';
import orcidSVG from '../icons/ORCID_iD.svg';

// --- PLACEHOLDER DATA ---
const bio = [
  "Hello! I'm an experimental particle physicist hunting for dark matter. I grew up in Colorado and studied physics at the University of Colorado as a Boettcher Scholar, picking up minors in math and computer science along the way. I spent a year in a masters program at Stony Brook in New York, which is where I really got interested in working with dark matter detectors, and this brought me to the University of Oregon for my PhD.",
  "Right now I work on two experiments at once. With Tien-Tien Yu and the SENSEI collaboration I look for dark matter floating around in our own galaxy, using ultra-sensitive silicon detectors deep underground. SENSEI revolutionized the search for sub-GeV dark matter, and we have been continuing to set new constraints on sub-GeV dark matter searches at SNOLAB. With Eric Torrence and the FASER collaboration I look for dark matter produced in the highest-energy collisions at the LHC. That same detector caught the very first collider neutrinos anyone has ever seen!",
  "I'm not always behind a laptop. I spent a year at Fermilab in the CCD lab trying to understand the tiny backgrounds that hold these searches back, and I genuinely love getting hands-on with hardware. I also work on the theory side that tells experiments like ours where to point, including a public code package I wrote for calculating dark matter signals. All in all I've been lucky to author or co-author 10+ peer-reviewed papers with some very talented people.",
];
const now = "Finishing my dissertation at Oregon, leading FASER's next-generation dark photon search, studying charge traps in SENSEI's Skipper-CCDs, and working on analysis for our third science run at SNOLAB.";
const outreach = "I care a lot about who gets to be a scientist. I've led demos and public talks at the Denver Museum of Nature & Science and the Oregon Museum of Science Industry, served on panels to answer the public's questions about physics through Fermilab's Saturday Morning Physics, and have brought hands-on physics to under-resourced schools in Boulder with PISEC. I also mentor undergrads and younger grad students at Oregon through the JUMP mentorship program. I want to keep science accessible to the public, and inspire people from all walks of life, particular those of underrepresented class and race to pursue their passions and become future scientists.";
// const photoLink = "../img/uncropped_ansh.jpg";
import AnshPhoto from "../img/cropped_ansh.jpeg";
const timezone = "America/Eugene";
const publications = {
    summary: "For more information on my papers, feel free to check out the links below or get in touch!",
    links: [
        { name: 'ORCID', url: 'https://orcid.org/0000-0002-5447-8304', icon: orcidSVG,color: 'text-yellow-400'},
        { name: 'inspirehep', url: 'https://inspirehep.net/authors/2789549', icon: InspireHepSVG,color: 'text-yellow-400'},
        { name: 'Google Scholar', url: 'https://scholar.google.com/citations?user=_XUdxmMAAAAJ&hl=en', icon: gscholarSVG,color: 'text-yellow-400'}, 
    ]
};
const otherInterests = [
    "Alpine Hiking & Mountaineering",
    "Classical Piano",
    "Films (any) and Books (scifi, horror, litfic)",
    "Photography (see my linked photos!)",
    "Playing table tennis for the University of Oregon",
];
// ------------------------
---

<BaseLayout title="About Me">
  <div class="max-w-5xl mx-auto pt-20 pb-28 px-6 relative z-10 animate-fade-in-up">

    <!-- Masthead: oversized Charter title, left-aligned (editorial, not centered) -->
    <header class="mb-14">
      <h1 class="font-charter text-deep text-[clamp(2.75rem,7vw,4.5rem)] leading-[0.95] tracking-[-0.02em]">
        Ansh Desai
      </h1>
    </header>

    <!-- Lead: bio runs wide alongside a tall portrait. Asymmetric 5/3 split. -->
    <div class="grid grid-cols-1 md:grid-cols-8 gap-x-10 gap-y-8 items-start">

      <!-- Bio (wide), Charter drop-cap on the first beat, generous measure -->
      <div class="md:col-span-5 space-y-5">
        {bio.map((para, i) => (
          <p class:list={["font-charter text-[1.15rem] leading-[1.75] text-ink", i === 0 && "first-letter:font-charter first-letter:text-deep first-letter:text-[3.4rem] first-letter:leading-[0.8] first-letter:float-left first-letter:pr-3 first-letter:pt-1"]}>
            {para}
          </p>
        ))}
      </div>

      <!-- Portrait (tall sidebar) -->
      <figure class="md:col-span-3">
        <Image src={AnshPhoto} alt="A photo of Ansh." class="rounded-lg w-full ring-1 ring-line" />
      </figure>
    </div>

    <!-- Now — a single emphasized strip, the one place orange earns its keep -->
    <section class="mt-16 border-l-2 border-orange pl-5">
      <h2 class="font-plex-mono text-xs uppercase tracking-[0.25em] text-orange mb-2 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-green animate-pulse-slow"></span> Now
      </h2>
      <p class="font-charter text-[1.05rem] leading-relaxed text-ink max-w-2xl">{now}</p>
    </section>

    <!-- Outreach & mentoring -->
    <section class="mt-16 max-w-3xl">
      <h2 class="font-plex-mono text-xs uppercase tracking-[0.25em] text-azure mb-4">Outreach &amp; mentoring</h2>
      <p class="font-charter text-[1.1rem] leading-[1.75] text-ink">{outreach}</p>
    </section>

    <!-- Lower band: deliberately uneven — interests run wide, a slim meta rail beside -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-8 gap-x-10 gap-y-12">

      <!-- Interests (wide) -->
      <section class="md:col-span-5">
        <h2 class="font-plex-mono text-xs uppercase tracking-[0.25em] text-azure mb-4">Beyond physics</h2>
        <ul class="space-y-2.5 text-ink">
          {otherInterests.map(interest => (
            <li class="flex gap-3 leading-relaxed">
              <span class="text-azure select-none">✱</span>
              <span>{interest}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Meta rail (narrow): clock, publications, connect stacked -->
      <aside class="md:col-span-3 space-y-10">

        <!-- Clock -->
        <div>
          <h2 class="font-plex-mono text-xs uppercase tracking-[0.25em] text-muted mb-2 flex items-center gap-2">
            <Clock size="14" /> {timezone.split('/').pop().replace('_', ' ')}
          </h2>
          <div id="timezone-clock" class="font-plex-mono text-3xl font-medium text-deep tabular-nums">--:--</div>
          <div id="timezone-date" class="font-plex-mono text-xs mt-1 text-muted">--/--/----</div>
        </div>

        <!-- Publications -->
        <div>
          <h2 class="font-plex-mono text-xs uppercase tracking-[0.25em] text-muted mb-2">Publications</h2>
          <p class="text-sm leading-relaxed text-muted mb-3">{publications.summary}</p>
          <div class="flex gap-3">
            {publications.links.map((link) => (
              <a href={link.url} aria-label={link.name} class="p-2.5 rounded-full bg-surface ring-1 ring-line transition-all hover:ring-azure hover:-translate-y-0.5">
                <link.icon class="w-6 h-6" />
              </a>
            ))}
          </div>
        </div>

        <!-- Connect -->
        <div>
          <h2 class="font-plex-mono text-xs uppercase tracking-[0.25em] text-muted mb-2">Connect</h2>
          <div class="flex gap-3 text-deep">
            <a href="https://www.github.com/anshsdesai" class="p-2.5 rounded-full bg-surface ring-1 ring-line transition-all hover:ring-azure hover:text-azure hover:-translate-y-0.5" aria-label="Github"><Github size="18" /></a>
            <a href="https://www.linkedin.com/in/anshsdesai" class="p-2.5 rounded-full bg-surface ring-1 ring-line transition-all hover:ring-azure hover:text-azure hover:-translate-y-0.5" aria-label="LinkedIn"><Linkedin size="18" /></a>
            <a href="mailto:ansh.s.desai@proton.me" class="p-2.5 rounded-full bg-surface ring-1 ring-line transition-all hover:ring-azure hover:text-azure hover:-translate-y-0.5" aria-label="Email"><Mail size="18" /></a>
          </div>
        </div>

      </aside>
    </div>
  </div>
</BaseLayout>

<!-- Live Clock Script -->
<script>
    function updateClock() {
        // Use the specified timezone (America/Los_Angeles in this example)
        const timezone = "America/Los_Angeles"; 
        const now = new Date();
        
        // Format options for time
        const timeOptions = {
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            timeZone: timezone
        };
        
        // Format options for date
        const dateOptions = {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            timeZone: timezone
        };

        const timeString = now.toLocaleTimeString('en-US', timeOptions);
        const dateString = now.toLocaleDateString('en-US', dateOptions);

        const clockElement = document.getElementById('timezone-clock');
        const dateElement = document.getElementById('timezone-date');

        if (clockElement) {
            clockElement.textContent = timeString;
        }
        if (dateElement) {
            dateElement.textContent = dateString;
        }
    }

    // Update the clock immediately and then every second
    updateClock();
    const intervalId = setInterval(updateClock, 1000);

    // Clean up interval when the element is removed (though in Astro this is mainly for SPA-like navigation, good practice)
    document.addEventListener('astro:before-swap', () => clearInterval(intervalId));
</script>