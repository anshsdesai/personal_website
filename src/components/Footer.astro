---
// Get the current year for the copyright notice
const currentYear = new Date().getFullYear();

// Static data based on your profile
const siteAuthor = "Ansh Desai";
const authorCredential = "Physics PhD Candidate @ University of Oregon";

const authorLocation = "Eugene, Oregon";
// You could also grab the timezone from your about page data: America/Eugene
// const locationTimeZone = "America/Eugene"; 

import { MapPin } from 'lucide-astro';
import { GraduationCap } from 'lucide-astro';


---

<footer id="main-site-footer" class="w-full relative z-20 mt-12 border-t border-line">
    <div class="max-w-6xl mx-auto py-8 px-6 text-sm text-muted flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">

        <!-- Left Side: Copyright and Author -->
        <div class="text-center sm:text-left">
            <span class="text-azure">✱</span> &copy; {currentYear} {siteAuthor}. All Rights Reserved.
        </div>

        <!-- Right Side: Credential and Location -->
        <div class="flex items-center space-x-2">
            <GraduationCap size="18" />
            <span>{authorCredential}</span>

            <MapPin size="18" />
            <span>{authorLocation}</span>
        </div>
        
    </div>
</footer>